rules_version = '2';
// Правила доступа к базе Wrap PRO.
// Владелец — тот, кто зарегистрировался первым (записан в config/owner).
// Остальные получают доступ только после одобрения владельцем и только к своим разделам.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function meDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasMe() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return isOwner() || (hasMe() && meDoc().get('approved', false) == true && !meDoc().get('emailPending', false)); }
    function hasRealEmail() {
      let email = request.auth.token.get('email', '');
      return email is string && email.matches('^[^@]+@[^@]+[.][^@]+$')
        && !email.lower().matches('.*@zamery[.]app$');
    }
    function hasVerifiedEmail() {
      return hasRealEmail() && request.auth.token.get('email_verified', false) == true;
    }
    function hasRole(r) {
      return isOwner() || (approved() && (r in meDoc().get('roles', []) || 'admin' in meDoc().get('roles', [])));
    }
    // «Управление»: владелец или сотрудник с правом manager
    function isManager() { return isOwner() || (approved() && 'manager' in meDoc().get('roles', [])); }
    function priceDoc() { return get(/databases/$(database)/documents/settings/prices).data; }
    // Цена за м² для смены: личная ставка сотрудника, если задана, иначе стандартная
    function rateDoc() { return /databases/$(database)/documents/rates/$(request.auth.uid); }
    function expPrice(k) {
      let r = exists(rateDoc()) ? get(rateDoc()).data.get(k, null) : null;
      return r != null ? r : priceDoc().get(k, 0);
    }

    // Отметка относится к открытой смене текущего сотрудника.
    function ownOpenShift(sid) {
      let p = /databases/$(database)/documents/shifts/$(sid);
      return sid is string && exists(p)
        && get(p).data.uid == request.auth.uid && get(p).data.end == null
        && getAfter(p).data.end == null;
    }
    // Сумма смены должна совпадать с «площадь × цена» (допуск 1 ₽ на округление)
    function sumMatches(d) {
      return d.cutArea is number && d.glueArea is number && d.sum is number
        && d.cutArea >= 0 && d.glueArea >= 0
        && math.abs(d.sum - (d.cutArea * d.priceCut + d.glueArea * d.priceGlue)) <= 1;
    }

    // Кто владелец. Первый подтверждённый профиль получает право создать запись.
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid
        && hasVerifiedEmail()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailPending == false;
    }

    // Профили сотрудников. Сам себе человек может только создать профиль без прав.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || approved());
      allow create: if signedIn() && request.auth.uid == uid
        && hasRealEmail() && request.resource.data.emailPending == true
        && request.resource.data.roles == []
        && request.resource.data.approved == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && !('rateCut' in request.resource.data) && !('rateGlue' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      // Подтверждение относится только к своему профилю и не выдаёт рабочих прав.
      allow update: if signedIn() && request.auth.uid == uid && hasVerifiedEmail()
        && resource.data.emailPending == true && request.resource.data.emailPending == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailPending']);
      // Руководитель выдаёт доступ после подтверждения почты; старые профили уже готовы.
      allow update: if isManager() && (uid != get(ownerDoc()).data.uid || isOwner())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['emailPending'])
        && (!resource.data.get('emailPending', false) || request.resource.data.approved == false);
      allow delete: if isManager() && uid != get(ownerDoc()).data.uid;
    }

    // Личные настройки внешнего вида (тема, цвет, стекло): каждый видит и меняет только свои
    match /prefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Стандартные цены за м²
    match /settings/{id} {
      allow read: if approved();
      allow write: if isManager();
    }

    // Личные ставки: видят только руководство и сам сотрудник
    match /rates/{uid} {
      allow read: if isManager() || (signedIn() && request.auth.uid == uid);
      allow write: if isManager();
    }

    // Объекты, окна, кабинеты — пишет только тот, у кого есть право «Замер»
    // Удалять объекты и кабинеты может только руководство
    match /objects/{oid} {
      allow read: if approved();
      allow create, update: if hasRole('measure');
      allow delete: if isManager();
      // окна: замерщик только добавляет новые, менять и удалять размеры может руководство
      match /types/{t} { allow read: if approved(); allow create: if hasRole('measure'); allow update, delete: if isManager(); }
      match /rooms/{r} {
        allow read: if approved();
        allow create, update: if hasRole('measure');
        allow delete: if isManager();
      }
      // Отметки нарезки и оклейки: только своим именем, только с нужным правом,
      // разумное количество и только в свою открытую смену
      match /log/{l} {
        allow read: if approved();
        allow create: if request.resource.data.kind in ['cut', 'glue']
          && hasRole(request.resource.data.kind)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.q is int
          && request.resource.data.q >= -500 && request.resource.data.q <= 500
          && ('shift' in request.resource.data) && ownOpenShift(request.resource.data.shift);
        allow delete: if isManager();
      }
    }


    // Смены: сотрудник видит и закрывает только свои; цену подставить нельзя — она проверяется здесь
    match /shifts/{sid} {
      allow read: if isManager() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.end == null
        && request.resource.data.bonus == 0
        && request.resource.data.priceCut == expPrice('cut')
        && request.resource.data.priceGlue == expPrice('glue');
      allow update: if isManager() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.end == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'cutArea', 'glueArea', 'sum'])
        && request.resource.data.end is number
        && sumMatches(request.resource.data));
      allow delete: if isManager();
    }
  }
}
